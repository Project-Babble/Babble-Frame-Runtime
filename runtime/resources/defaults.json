{
  "version": 1,
  "log_level": "info",
  "stats_interval_s": 5,
  "threads": {
    "main": {
      "name": "babble-runtime",
      "cpus": [0, 1],
      "nice": 0
    },
    "capL": {
      "cpus": [0],
      "nice": -5
    },
    "capR": {
      "cpus": [1],
      "nice": -5
    },
    "eye": {
      "cpus": [1],
      "nice": -5
    },
    "infM": {
      "cpus": [2],
      "nice": 0
    },
    "infE": {
      "cpus": [3],
      "nice": 0
    },
    "sink": {
      "cpus": [0],
      "nice": 0
    },
    "osc": {
      "cpus": [0],
      "nice": 0
    },
    "pupil": {
      "cpus": [4],
      "nice": 5
    },
    "gaze": {
      "cpus": [0, 1],
      "nice": 0
    },
    "steamvr": {
      "cpus": [0, 1],
      "nice": 0
    }
  },
  "sources": {
    "mouth": {
      "type": "frame_ov6211_stereo",
      "enabled": true,
      "nodes": { "left": "/dev/video9", "right": "/dev/video13" },
      "subdev_name_prefixes": ["sf-ov6211-sec", "sf-ov6211-pri"],
      "format": { "width": 400, "height": 400, "fourcc": "BA81" },
      "buffers": 6,
      "pair_tolerance_us": 4000,
      "sensor_fps": 120,
      "process_fps": 120,
      "controls_on_start": { "exposure": 160, "analogue_gain": 1, "frame_sync_fsin_enable": 0 },
      "strobe": {
        "on": { "strobe_enable": 1, "strobe_frame_pulse_start": 1 },
        "off": { "strobe_enable": 0 }
      },
      "auto_exposure": { "mode": "fixed", "target_mean": 110, "interval_frames": 8 },
      "reopen_backoff_ms": { "min": 500, "max": 5000 },
      "pause_when_absent": true
    },
    "eye": {
      "type": "frame_dsp_eye",
      "enabled": true,
      "dsp_version": 17,
      "ctrl_base_candidates": ["0x234000", "0x124000"],
      "request_fps": 120,
      "process_fps": 90,
      "poll_interval_us": 400,
      "no_frames_timeout_ms": 2000,
      "reopen_backoff_ms": { "min": 5000, "max": 60000 },
      "crop": {
        "left": [16, 56, 400, 400],
        "right": [16, 0, 400, 400]
      },
      "predict_margin_us": 1500,
      "pause_when_absent": true
    }
  },
  "pipelines": {
    "mouth": {
      "type": "fusionnet_mouth",
      "enabled": true,
      "from": "mouth",
      "thread": "infM",
      "model": "fusionnet_int8_xnnpack_qat_linear.pte",
      "swap": false,
      "flip": "r",
      "rotate": 0,
      "interp": "linear",
      "ema": 0.5,
      "calibration": { "mode": "manual", "file": "calibration_mouth.json" }
    },
    "eye": {
      "type": "babble_eye",
      "enabled": true,
      "from": "eye",
      "thread": "infE",
      "pupil_thread": "pupil",
      "lid_model": "lid_mnv4_160_int8.pte",
      "pupil_model": "pupil_cnx_160_fp32.pte",
      "update_hz": 90,
      "pupil_hz": 3,
      "pupil_gain": 2.0,
      "lid_alpha": 0.6,
      "calib": true,
      "calib_window_s": 20,
      "calib_warmup_s": 3,
      "pupil_gate": 0.4,
      "pupil_gate_hys": 0.1,
      "pupil_hold_s": 0.1,
      "pupil_alpha": 0.2,
      "pupil_rate": 0.6,
      "pupil_base_s": 60,
      "babble_swap": false
    },
    "gaze": {
      "type": "steamvr_gaze",
      "enabled": true,
      "thread": "gaze",
      "rate_hz": 90,
      "ipd": "auto",
      "max_deg": 45,
      "flip_y": false,
      "yaw_offset": 0,
      "pitch_offset": 0,
      "roll_offset": 0,
      "stale_s": 0.5
    }
  },
  "sinks": {
    "debug": { "type": "debug", "enabled": true, "thread": "sink", "rate_hz": 2, "dump_dir": null, "dump_count": 0 },
    "vrcft": {
      "type": "osc",
      "enabled": true,
      "thread": "osc",
      "host": "127.0.0.1",
      "port": 8888,
      "prefix": "",
      "max_rate_hz": 0,
      "test_pattern": false,
      "exclude": []
    }
  },
  "arbiter": {
    "root": "/etc/babble-camera",
    "min_version": 1,
    "module": "steamframe_ov6211_stereo_subdev",
    "streams_unit": "babble-camera-streams.service",
    "fpga_read_reg": "/usr/lib/deckard-fpga/read_reg",
    "media_device": "/dev/media0",
    "sensor_entities": ["sf-ov6211-pri", "sf-ov6211-sec"],
    "poll_interval_ms": { "idle": 1000, "streaming": 5000 }
  },
  "steamvr": {
    "controller_type": "frame_hmd",
    "proximity_path": "/user/head/proximity",
    "eyetracking_path": "/user/head/eyetracking"
  }
}
