{
  "version": 1,
  "log_level": "info",
  "log_levels": {},
  "log_file": { "max_mb": 8, "keep": 3, "stats_max_mb": 4 },
  "stats_interval_s": 5,
  "stats_summary_s": 60,
  "mouth_source": "frunk",
  "output": "vrcft",
  "threads": {
    "main": {
      "name": "babble-runtime",
      "cpus": [0, 1],
      "nice": 0
    },
    "capL": {
      "cpus": [0],
      "nice": -5
    },
    "capR": {
      "cpus": [1],
      "nice": -5
    },
    "eye": {
      "cpus": [1],
      "nice": -5
    },
    "infM": {
      "cpus": [2],
      "nice": 0
    },
    "infE": {
      "cpus": [3],
      "nice": 0
    },
    "sink": {
      "cpus": [0],
      "nice": 0
    },
    "osc": {
      "cpus": [0],
      "nice": 0
    },
    "pupil": {
      "cpus": [4],
      "nice": 5
    },
    "gaze": {
      "cpus": [0, 1],
      "nice": 0
    },
    "steamvr": {
      "cpus": [0, 1],
      "nice": 0
    },
    "ui": {
      "cpus": [0, 1],
      "nice": 5
    },
    "face": {
      "cpus": [0, 1],
      "nice": -5
    },
    "eyesrv": {
      "cpus": [0, 1],
      "nice": 0
    },
    "record": {
      "cpus": [5, 6, 7],
      "nice": 5
    },
    "net": {
      "cpus": [0],
      "nice": 10
    }
  },
  "sources": {
    "mouth": {
      "type": "frame_ov6211_stereo",
      "enabled": true,
      "nodes": { "left": "/dev/video9", "right": "/dev/video13" },
      "subdev_name_prefixes": ["sf-ov6211-sec", "sf-ov6211-pri"],
      "format": { "width": 400, "height": 400, "fourcc": "BA81" },
      "buffers": 6,
      "pair_tolerance_us": 4000,
      "sensor_fps": 120,
      "process_fps": 120,
      "tracking": true,
      "controls_on_start": { "exposure": 160, "analogue_gain": 1, "frame_sync_fsin_enable": 0 },
      "strobe": {
        "on": { "strobe_enable": 1, "strobe_frame_pulse_start": 1 },
        "off": { "strobe_enable": 0 }
      },
      "auto_exposure": { "mode": "fixed", "target_mean": 110, "interval_frames": 8 },
      "reopen_backoff_ms": { "min": 500, "max": 5000 },
      "pause_when_absent": true
    },
    "eye": {
      "type": "frame_dsp_eye",
      "enabled": true,
      "dsp_version": 17,
      "ctrl_base_candidates": ["0x234000", "0x124000"],
      "rate_divisor": 1,
      "tracking": true,
      "poll_interval_us": 400,
      "no_frames_timeout_ms": 2000,
      "reopen_backoff_ms": { "min": 5000, "max": 60000 },
      "crop": {
        "left": [16, 56, 400, 400],
        "right": [16, 0, 400, 400]
      },
      "predict_margin_us": 1500,
      "pause_when_absent": true
    },
    "face": {
      "type": "babble_usb",
      "enabled": true,
      "camera": "",
      "vendor": "303a",
      "product": "8000",
      "width": 240,
      "height": 240,
      "fps": 30,
      "process_fps": 30,
      "tracking": true,
      "pause_when_absent": true,
      "reopen_backoff_ms": { "min": 1000, "max": 10000 }
    }
  },
  "pipelines": {
    "mouth": {
      "type": "fusionnet_mouth",
      "enabled": true,
      "from": "mouth",
      "thread": "infM",
      "model": "fusionnet_int8_xnnpack_qat_linear.pte",
      "swap": false,
      "flip": "r",
      "rotate": 0,
      "interp": "linear",
      "ema": 0.5,
      "calibration": { "mode": "auto", "file": "calibration_mouth.json" }
    },
    "eye": {
      "type": "babble_eye",
      "enabled": true,
      "from": "eye",
      "thread": "infE",
      "pupil_thread": "pupil",
      "model": "eye_split96_uncapped_fp16.pte",
      "openness_source": "model",
      "lid_model": "lid_mnv4_160_int8.pte",
      "pupil_model": "pupil_cnx_160_fp32.pte",
      "update_hz": 90,
      "pupil_hz": 3,
      "pupil_gain": 2.0,
      "lid_calibration": "baseline",
      "widen_seed": 0.15,
      "widen_ceiling_max": 1.6,
      "lid_saturation": 1.0,
      "calib_tol": 0.15,
      "lid_alpha": 0.6,
      "calib": true,
      "calib_window_s": 20,
      "calib_warmup_s": 3,
      "pupil_gate": 0.4,
      "pupil_gate_hys": 0.1,
      "pupil_hold_s": 0.1,
      "pupil_alpha": 0.2,
      "pupil_rate": 0.6,
      "pupil_base_s": 60,
      "babble_swap": false
    },
    "gaze": {
      "type": "steamvr_gaze",
      "enabled": true,
      "feed": "eye",
      "gaze_source": "independent",
      "thread": "gaze",
      "rate_hz": 90,
      "ipd": "auto",
      "scaling": "angle",
      "max_deg": 45,
      "flip_y": false,
      "yaw_offset": 0,
      "pitch_offset": 0,
      "roll_offset": 0,
      "stale_s": 0.5
    },
    "face": {
      "type": "babble_mono_face",
      "enabled": true,
      "from": "face",
      "thread": "infM",
      "model": "face_mono_224_fp16.pte",
      "roi": [],
      "gain": 1.0,
      "rotate": 0,
      "flip": "none",
      "one_euro": { "min_cutoff": 0.5, "beta": 3.0, "d_cutoff": 1.0 },
      "calibration": { "mode": "auto" }
    }
  },
  "sinks": {
    "debug": { "type": "debug", "enabled": true, "thread": "sink", "rate_hz": 2, "dump_dir": null, "dump_count": 0 },
    "camera_stream": {
      "type": "camera_stream",
      "enabled": true,
      "thread": "sink",
      "active": false,
      "port": 9099,
      "views": ["face_l", "face_r", "eye_l", "eye_r"],
      "fps": 60,
      "quality": 80,
      "max_clients": 4
    },
    "vrcft": {
      "type": "osc",
      "enabled": true,
      "thread": "osc",
      "host": "127.0.0.1",
      "port": 8888,
      "prefix": "",
      "max_rate_hz": 0,
      "test_pattern": false,
      "exclude": []
    },
    "pc": {
      "type": "vrcft_link",
      "enabled": true,
      "output": "vrcft",
      "thread": "osc",
      "control_port": 6767,
      "path_order": ["dongle", "usb", "lan"],
      "interfaces": { "wlanap": "dongle", "usb0": "usb" },
      "hosts": [],
      "beacon_s": [2, 5],
      "ping_s": 1,
      "timeout_s": 3,
      "name": "",
      "prefix": "",
      "max_rate_hz": 0,
      "exclude": []
    },
    "record": {
      "type": "record",
      "enabled": true,
      "thread": "record",
      "dir": "~/.local/share/babble-frame-runtime/captures",
      "encoder": ["ffmpeg", "-hide_banner", "-loglevel", "warning", "-f", "rawvideo", "-pix_fmt", "gray",
                  "-s", "{w}x{h}", "-r", "{fps}", "-i", "-", "-c:v", "libx264", "-preset", "ultrafast",
                  "-qp", "0", "-pix_fmt", "gray", "-g", "{fps}", "-threads", "3", "{out}"],
      "container": "mkv",
      "queue_frames": 64,
      "min_free_gb": 5
    },
    "vrc_native": {
      "type": "vrc_native",
      "enabled": true,
      "output": "vrc_native",
      "thread": "osc",
      "target": "auto",
      "host": "",
      "port": 9000,
      "steam_link_log": "",
      "max_rate_hz": 0
    }
  },
  "arbiter": {
    "root": "/etc/babble-camera",
    "min_version": 1,
    "module": "steamframe_ov6211_stereo_subdev",
    "streams_unit": "babble-camera-streams.service",
    "fpga_read_reg": "/usr/lib/deckard-fpga/read_reg",
    "media_device": "/dev/media0",
    "sensor_entities": ["sf-ov6211-pri", "sf-ov6211-sec"],
    "poll_interval_ms": { "idle": 1000, "streaming": 5000 }
  },
  "steamvr": {
    "controller_type": "frame_hmd",
    "proximity_path": "/user/head/proximity",
    "eyetracking_path": "/user/head/eyetracking",
    "absent_after_s": 2
  },
  "visualizer": {
    "command": ["~/aura_vis/run.sh"]
  },
  "eye_server": {
    "path": "/dev/shm/eye-server.mmap",
    "thread": "eyesrv"
  },
  "capture": {
    "app": {
      "repo": "Project-Babble/Babble-Guided-Dataset-Capture",
      "asset_prefix": "babble-dataset-capture-",
      "api_url": "https://api.github.com/repos/{repo}/releases?per_page=20",
      "dir": "~/.local/share/babble-frame-runtime/apps/dataset-capture",
      "prereleases": false,
      "check_hours": 6
    },
    "upload": {
      "endpoint": "http://207.211.165.193:3900",
      "bucket": "babbledata",
      "region": "garage",
      "access_key": "",
      "secret_key": "",
      "public_key": "",
      "qp": 20
    }
  },
  "steamvr_settings": {
    "section": "driver_babble",
    "values": [
      { "key": "mouthTracking", "id": "/sources/mouth/tracking" },
      { "key": "mouthSource", "id": "/mouth_source" },
      { "key": "output", "id": "/output" },
      { "key": "mouthRate", "id": "/sources/mouth/process_fps" },
      { "key": "eyeTracking", "id": "/sources/eye/tracking" },
      { "key": "eyeRateDivisor", "id": "/sources/eye/rate_divisor" },
      { "key": "opennessSource", "id": "/pipelines/eye/openness_source" },
      { "key": "gazeSource", "id": "/pipelines/gaze/gaze_source" },
      { "key": "debugOverlay", "id": "/dashboard/enabled" }
    ]
  },
  "dashboard": {
    "enabled": false,
    "width_m": 1.6,
    "settings": [
      {
        "id": "/sources/mouth/process_fps",
        "label": "Mouth tracking rate",
        "hint": "Updates per second. Lower rates save battery.",
        "unit": "Hz",
        "options": [30, 60, 90, 120]
      },
      {
        "id": "/sources/eye/rate_divisor",
        "label": "Eye tracking rate",
        "hint": "A share of the eye camera rate, which follows the display refresh rate. Lower saves battery.",
        "options": [1, 2, 3],
        "labels": ["1:1", "1:2", "1:3"]
      },
      {
        "id": "/sinks/camera_stream/active",
        "page": "diagnostics",
        "persist": false,
        "label": "Camera stream",
        "hint": "MJPEG on TCP 9099 for infer.py (net:<headset>:9099). Off after a restart."
      }
    ]
  }
}
