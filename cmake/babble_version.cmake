# This script runs at every build and writes the version header and the settings schema with the version in it.

set(display "${VERSION}")
if(DEV)
    execute_process(COMMAND git -C "${SRC_DIR}" describe --always --dirty --abbrev=7
                    OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_failed)
    if(git_failed AND EXISTS "${SRC_DIR}/.babble-rev")
        file(READ "${SRC_DIR}/.babble-rev" rev)
        string(STRIP "${rev}" rev)
    endif()
    if(rev)
        set(display "${VERSION} (dev ${rev})")
    else()
        set(display "${VERSION} (dev)")
    endif()
endif()

# Write `out` only if `content` is different, so that dependent targets do not rebuild.
function(write_if_changed out content)
    file(WRITE "${out}.tmp" "${content}")
    configure_file("${out}.tmp" "${out}" COPYONLY)
    file(REMOVE "${out}.tmp")
endfunction()

write_if_changed("${OUT_DIR}/babble_version.h"
"// Generated by cmake/babble_version.cmake.
#pragma once
#define BABBLE_VERSION \"${VERSION}\"
#define BABBLE_VERSION_DISPLAY \"${display}\"
#define BABBLE_PROFILE_NAME \"${PROFILE}\"
")

file(READ "${SCHEMA_IN}" schema)
string(REPLACE "@BABBLE_VERSION@" "${display}" schema "${schema}")
write_if_changed("${OUT_DIR}/settingsschema.vrsettings" "${schema}")
