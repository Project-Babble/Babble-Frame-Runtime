[
	{
		"title" : "Expression Tracking",
		"controller" : "babble_expression_tracking",
		"show_without_hmd" : true,
		"values" : [
			{
				"name" : "/settings/driver_babble/mouthTracking",
				"control" : "toggle",
				"label" : "Mouth Tracking",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/mouthSource",
				"control" : "segment",
				"label" : "Mouth Source",
				"text" : "Where mouth tracking comes from: the Frame's own mouth cameras (Frunk), or a USB camera such as a Babble face tracker. Pick the USB camera in the Babble app window's settings.",
				"options" : [
					{ "value" : "frunk", "label" : "Frunk" },
					{ "value" : "usb", "label" : "USB" }
				],
				"requires" : { "/settings/driver_babble/mouthTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/mouthRate",
				"control" : "segment",
				"label" : "Tracking Rate (Hz)",
				"options" : [
					{ "value" : 30, "label" : "30" },
					{ "value" : 60, "label" : "60" },
					{ "value" : 90, "label" : "90" },
					{ "value" : 120, "label" : "120" }
				],
				"requires" : { "/settings/driver_babble/mouthTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/mouthMirror",
				"control" : "toggle",
				"label" : "Mirror USB Camera",
				"text" : "Mirrors the image of a USB Babble face tracker. Turn off if left and right mouth movements are swapped on your avatar.",
				"on_label" : "On",
				"off_label" : "Off",
				"requires" : { "/settings/driver_babble/mouthTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/eyeTracking",
				"control" : "toggle",
				"label" : "Eye Tracking",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/eyeRateDivisor",
				"control" : "segment",
				"label" : "Tracking Rate",
				"text" : "A share of the eye camera rate. SteamVR sets the camera rate from the display refresh rate (up to about 90 Hz at 144 Hz). Lower rates save battery.",
				"options" : [
					{ "value" : 1, "label" : "1:1" },
					{ "value" : 2, "label" : "1:2" },
					{ "value" : 3, "label" : "1:3" }
				],
				"requires" : { "/settings/driver_babble/eyeTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/opennessSource",
				"control" : "segment",
				"label" : "Openness Source",
				"options" : [
					{ "value" : "model", "label" : "Babble" },
					{ "value" : "native", "label" : "Native" }
				],
				"advanced_only" : true,
				"requires" : { "/settings/driver_babble/eyeTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/gazeSource",
				"control" : "segment",
				"label" : "Gaze Source",
				"options" : [
					{ "value" : "combined", "label" : "Combined" },
					{ "value" : "independent", "label" : "Independent" }
				],
				"advanced_only" : true,
				"requires" : { "/settings/driver_babble/eyeTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/gazeSmoothing",
				"control" : "segment",
				"label" : "Gaze Smoothing",
				"text" : "Steadies the gaze. Stronger smoothing adds a little lag to fast eye movements.",
				"options" : [
					{ "value" : 0, "label" : "Off" },
					{ "value" : 1, "label" : "Low" },
					{ "value" : 2, "label" : "Medium" },
					{ "value" : 3, "label" : "High" }
				],
				"requires" : { "/settings/driver_babble/eyeTracking" : true }
			},
			{
				"name" : "/settings/driver_babble/outputVrcft",
				"control" : "toggle",
				"label" : "VRCFaceTracking Output",
				"text" : "Sends tracking to the Babble module in VRCFaceTracking on your PC. Set a PC address and the other output settings in the Babble app window.",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/outputVrcNative",
				"control" : "toggle",
				"label" : "VRChat Native Output",
				"text" : "Sends tracking straight into VRChat's own face tracking, on the PC you stream from or on the Frame.",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/outputBabbleOsc",
				"control" : "toggle",
				"label" : "Babble OSC Output",
				"text" : "Sends OSC in the Baballonia format to your PC on UDP 8888.",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/debugOverlay",
				"control" : "toggle",
				"label" : "Show App Window",
				"text" : "Adds a Babble tab to the SteamVR dashboard with live tracking status, settings and diagnostics.",
				"on_label" : "On",
				"off_label" : "Off"
			},
			{
				"name" : "/settings/driver_babble/version",
				"control" : "label",
				"label" : "Babble Frame Runtime @BABBLE_VERSION@"
			}
		]
	}
]
